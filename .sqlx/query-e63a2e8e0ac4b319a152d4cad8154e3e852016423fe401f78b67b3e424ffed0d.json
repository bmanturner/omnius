  "query": "\n                SELECT id, name, created_at, updated_at, version\n                FROM reference_records\n                WHERE $1::timestamptz IS NULL\n                   OR (created_at, id) > ($1, $2)\n                ORDER BY created_at ASC, id ASC\n                LIMIT $3\n                ",
