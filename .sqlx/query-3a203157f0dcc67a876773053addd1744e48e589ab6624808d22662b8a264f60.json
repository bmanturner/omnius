{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, name, created_at, updated_at, version\n                FROM reference_records\n                WHERE ($1::timestamptz IS NULL\n                   OR (created_at, id) > ($1, $2))\n                  AND ($3::text IS NULL OR strpos(lower(name), lower($3)) > 0)\n                ORDER BY created_at ASC, id ASC\n                LIMIT $4\n                ",
