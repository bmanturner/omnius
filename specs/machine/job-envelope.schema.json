{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rust-service-kit/job-envelope.schema.json",
  "title": "Versioned Job Envelope",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "created_at",
    "correlation_id",
    "attempt_policy",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "attempt_policy": {
      "type": "object",
      "required": [
        "max_attempts",
        "timeout_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
