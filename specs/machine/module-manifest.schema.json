{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnius/module-manifest.schema.json",
  "title": "Omnius Module",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "owner",
    "spec",
    "kind",
    "requires",
    "conflicts_with",
    "criticality",
    "runtime_toggle",
    "runtime_dependencies",
    "primary_crates",
    "composition",
    "acceptance",
    "persistence",
    "configuration",
    "routes",
    "background_tasks",
    "health_checks",
    "metrics_prefix",
    "test_fixtures",
    "generator_ownership",
    "removal_behavior"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "string",
      "pattern": "^OMNIUS-[0-9]{3}$"
    },
    "kind": {
      "enum": [
        "kernel",
        "capability",
        "infrastructure",
        "transport",
        "product",
        "tooling"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provider_slot": {
      "type": [
        "string",
        "null"
      ]
    },
    "criticality": {
      "enum": [
        "required",
        "degraded",
        "best-effort"
      ]
    },
    "runtime_toggle": {
      "type": "boolean"
    },
    "runtime_dependencies": {
      "type": "array",
      "items": {
        "enum": [
          "postgresql",
          "redis-or-valkey",
          "oidc-provider",
          "nats-jetstream",
          "object-store",
          "smtp-or-email-provider",
          "svix",
          "flag-provider",
          "meilisearch",
          "configured-llm-provider-apis",
          "aws-bedrock-runtime",
          "google-vertex-ai"
        ]
      },
      "uniqueItems": true
    },
    "primary_crates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "composition": {
      "type": "object",
      "required": [
        "crates",
        "registrar",
        "application_requirements"
      ],
      "properties": {
        "crates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dependency",
              "features"
            ],
            "properties": {
              "dependency": {
                "type": "string",
                "minLength": 1
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "registrar": {
          "type": "boolean"
        },
        "application_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "admin.authority-resolver",
              "admin.operation-handler",
              "auth-oidc.runtime",
              "auth-totp.runtime",
              "auth-webauthn.runtime",
              "auth.authenticated-runtime",
              "auth.oauth-runtime",
              "auth.redis-session-runtime",
              "billing.provider",
              "feature-flags.exposure-recorder",
              "feature-flags.provider",
              "graphql.request-data-injector",
              "graphql.schema",
              "grpc.application-service",
              "grpc.authenticator",
              "grpc.method-policies",
              "inbox.consumers",
              "jobs.handlers",
              "llm.evaluation-repository",
              "llm.media-authorization",
              "llm.media-scanner",
              "llm.tool-audit",
              "llm.tool-authorization",
              "mcp.apps-ports",
              "mcp.bearer-authenticator",
              "mcp.cancellation-runtime",
              "mcp.capability-executor",
              "mcp.capability-registry",
              "mcp.enterprise-ports",
              "mcp.subscription-authorizer",
              "mcp.subscription-delivery",
              "mcp.subscription-repository",
              "mcp.subscription-runtime",
              "mcp.task-payload-protector",
              "outbox.publisher",
              "privacy.authorizer",
              "privacy.consent-policy",
              "privacy.inventory-adapters",
              "privacy.inventory-manifest",
              "privacy.lifecycle-handler",
              "privacy.moderation-policy",
              "realtime.event-handler",
              "realtime.fanout-authorizer",
              "realtime.identity-revalidator",
              "scheduler.envelope-factory",
              "search.index-schema",
              "search.projection-resolver",
              "search.reauthorizer",
              "uploads.authorization",
              "uploads.workflow",
              "webhooks-inbound.handlers",
              "webhooks-inbound.provider-adapters",
              "webhooks-svix.replay-admission"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[A-Z]+-[0-9]{3}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "persistence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "configuration": {
      "type": "object",
      "required": [
        "prefix",
        "schema",
        "secret_fields"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "type",
              "required"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "boolean",
                  "string-array",
                  "integer-array"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "reference_default": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                ]
              },
              "environment": {
                "type": "string",
                "pattern": "^OMNIUS(?:__[A-Z][A-Z0-9_]*){2,}$"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "background_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metrics_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "test_fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "generator_ownership": {
      "type": "object",
      "required": [
        "kit_owned",
        "managed_regions",
        "derived"
      ],
      "properties": {
        "kit_owned": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "managed_regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "derived": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "removal_behavior": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}