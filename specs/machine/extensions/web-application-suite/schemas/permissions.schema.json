{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnius/web/permissions.schema.json",
  "title": "Public Permission Vocabulary",
  "type": "object",
  "required": [
    "schema_version",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "resource",
          "action",
          "deprecated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "deprecated": {
            "type": "boolean"
          },
          "replacement": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
