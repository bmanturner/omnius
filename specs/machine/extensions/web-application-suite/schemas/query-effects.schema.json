{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnius/web/query-effects.schema.json",
  "title": "Realtime Query Effects",
  "type": "object",
  "required": [
    "schema_version",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event",
          "actions"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "invalidate"
                  ],
                  "properties": {
                    "invalidate": {
                      "type": "object",
                      "required": [
                        "operation_id"
                      ],
                      "properties": {
                        "operation_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "parameters": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "revalidate_session"
                  ],
                  "properties": {
                    "revalidate_session": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "remove"
                  ],
                  "properties": {
                    "remove": {
                      "type": "object",
                      "required": [
                        "operation_id"
                      ],
                      "properties": {
                        "operation_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "parameters": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
