{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rust-service-kit/ai/prompt-definition.schema.json",
  "title": "Versioned Prompt Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "status",
    "owner",
    "input_schema",
    "template",
    "allowed_routes",
    "allowed_tools",
    "data_classification",
    "evaluation_sets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string"
    },
    "input_schema": {
      "type": "object"
    },
    "template": {
      "type": "string"
    },
    "allowed_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "type": "string"
    },
    "evaluation_sets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
