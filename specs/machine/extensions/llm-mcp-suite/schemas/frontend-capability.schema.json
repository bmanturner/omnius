{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnius/ai/frontend-capability.schema.json",
  "title": "Frontend Capability Mapping",
  "type": "object",
  "required": [
    "module_id",
    "exposure",
    "reason",
    "contracts",
    "provides"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "exposure": {
      "enum": [
        "browser",
        "none"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "contracts": {
      "type": "object",
      "required": [
        "openapi_tags",
        "asyncapi_events",
        "runtime_capabilities"
      ],
      "properties": {
        "openapi_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "asyncapi_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtime_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "provides": {
      "type": "object",
      "required": [
        "core_exports",
        "react_exports",
        "route_requirements",
        "query_effects",
        "testing"
      ],
      "properties": {
        "core_exports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "react_exports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "route_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "query_effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "testing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
