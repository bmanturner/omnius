{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnius/ai/mcp-extension.schema.json",
  "title": "MCP Extension Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "default_enabled",
    "module",
    "negotiation",
    "revision",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "stable",
        "draft",
        "experimental",
        "deprecated",
        "removed"
      ]
    },
    "default_enabled": {
      "type": "boolean"
    },
    "module": {
      "type": [
        "string",
        "null"
      ]
    },
    "negotiation": {
      "enum": [
        "per-request-capabilities",
        "not-wire-visible",
        "prohibited"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "uri",
        "revision"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
        },
        "revision": {
          "type": "string",
          "minLength": 40,
          "maxLength": 71,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|sha256:[0-9a-f]{64})$"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "stable",
              "draft",
              "experimental"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "negotiation": {
            "not": {
              "const": "prohibited"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "default_enabled": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "removed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "default_enabled": {
            "const": false
          },
          "module": {
            "const": null
          },
          "negotiation": {
            "const": "prohibited"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "negotiation": {
            "const": "prohibited"
          }
        },
        "required": [
          "negotiation"
        ]
      },
      "then": {
        "properties": {
          "default_enabled": {
            "const": false
          },
          "module": {
            "const": null
          }
        }
      }
    }
  ]
}
