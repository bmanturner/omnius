{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rust-service-kit/ai/llm-response.schema.json",
  "title": "Canonical LLM Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "response_id",
    "provider",
    "model",
    "status",
    "output",
    "usage",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string"
    },
    "response_id": {
      "type": "string"
    },
    "provider_response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "refused",
        "cancelled",
        "failed"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "output": {
      "type": "array",
      "items": {
        "$ref": "llm-content.schema.json"
      },
      "description": "Selected/default candidate output retained for ergonomic callers."
    },
    "selected_candidate_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "status",
          "output"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "refused",
              "cancelled",
              "failed"
            ]
          },
          "stop_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {
            "type": "array",
            "items": {
              "$ref": "llm-content.schema.json"
            }
          },
          "provider_metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "audio_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "audio_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "image_input_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "image_output_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "video_input_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "video_output_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tool_execution_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actual_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "provider_units": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
