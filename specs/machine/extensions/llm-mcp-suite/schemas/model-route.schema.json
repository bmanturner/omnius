{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnius/ai/model-route.schema.json",
  "title": "Model Route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "required_capabilities",
    "preferred_capabilities",
    "candidates",
    "fallback",
    "timeouts",
    "budget",
    "data_policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "preferred_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "fallback": {
      "type": "object",
      "required": [
        "allowed",
        "semantic_requirements"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "semantic_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "timeouts": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "data_policy": {
      "type": "object"
    }
  }
}
