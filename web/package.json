{
  "name": "@omnius/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:ts7": "node ../node_modules/typescript7/bin/tsc --project tsconfig.ts7.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@omnius/web-sdk": "workspace:*",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-router": "1.170.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "typescript": "6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
