{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnius.invalid/schemas/manual-accessibility-review.schema.json",
  "title": "Omnius manual keyboard and screen-reader release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "revision",
    "reviewedAt",
    "reviewer",
    "keyboard",
    "screenReader",
    "findings",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["pending", "approved"] },
    "revision": { "type": ["string", "null"] },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "reviewer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "keyboard": { "$ref": "#/$defs/keyboardReview" },
    "screenReader": { "$ref": "#/$defs/screenReaderReview" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocker", "major", "minor"] },
          "status": { "enum": ["open", "resolved", "accepted"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approvedBy", "approvedAt"],
      "properties": {
        "approved": { "type": "boolean" },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "result": { "enum": ["not-reviewed", "pass", "fail"] },
        "notes": { "type": "string" }
      }
    },
    "keyboardReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "operatingSystem", "scenarios"],
      "properties": {
        "browser": { "type": ["string", "null"] },
        "operatingSystem": { "type": ["string", "null"] },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
      }
    },
    "screenReaderReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistiveTechnology",
        "assistiveTechnologyVersion",
        "browser",
        "operatingSystem",
        "scenarios"
      ],
      "properties": {
        "assistiveTechnology": { "type": ["string", "null"] },
        "assistiveTechnologyVersion": { "type": ["string", "null"] },
        "browser": { "type": ["string", "null"] },
        "operatingSystem": { "type": ["string", "null"] },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
      }
    }
  }
}
