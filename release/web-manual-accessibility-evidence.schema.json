{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnius.dev/schemas/web-manual-accessibility-evidence.schema.json",
  "title": "Bound manual web accessibility review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "binding",
    "reviewedAt",
    "reviewer",
    "keyboard",
    "screenReader",
    "findings",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": { "const": "approved" },
    "binding": { "$ref": "#/$defs/binding" },
    "reviewedAt": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "keyboard": { "$ref": "#/$defs/keyboardReview" },
    "screenReader": { "$ref": "#/$defs/screenReaderReview" },
    "findings": { "type": "array", "maxItems": 0 },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "revision",
        "specManifestSha256",
        "contractAggregateSha256"
      ],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 7 },
        "specManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contractAggregateSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "result": { "const": "passed" },
        "notes": { "type": "string" }
      }
    },
    "keyboardReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "operatingSystem", "scenarios"],
      "properties": {
        "browser": { "type": "string", "minLength": 1 },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario" }
        }
      }
    },
    "screenReaderReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistiveTechnology",
        "assistiveTechnologyVersion",
        "browser",
        "operatingSystem",
        "scenarios"
      ],
      "properties": {
        "assistiveTechnology": { "type": "string", "minLength": 1 },
        "assistiveTechnologyVersion": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approvedBy", "approvedAt"],
      "properties": {
        "approved": { "const": true },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
