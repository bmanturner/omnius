{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnius.dev/schemas/web-release-command-result.schema.json",
  "title": "Bound web release command result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "status",
    "detail",
    "command",
    "argv",
    "exitCode",
    "startedAt",
    "completedAt",
    "binding",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "resultId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "detail": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "exitCode": { "type": "integer" },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "binding": { "$ref": "#/$defs/binding" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "revision",
        "specManifestSha256",
        "contractAggregateSha256"
      ],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 7 },
        "specManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contractAggregateSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
