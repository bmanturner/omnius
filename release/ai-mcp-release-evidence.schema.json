{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnius.dev/schemas/ai-mcp-release-evidence.schema.json",
  "title": "Bound AI and MCP release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "status",
    "generatedAt",
    "binding",
    "profiles",
    "criteria"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceId": { "const": "ai-mcp-release-readiness" },
    "status": { "const": "passed" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "binding": { "$ref": "#/$defs/binding" },
    "profiles": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/profile" }
    },
    "criteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "revision", "specManifestSha256", "contractAggregateSha256"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 7 },
        "specManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contractAggregateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "checks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "detail", "artifacts"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-AI-1(?:1[3-9]|20)$" },
        "status": { "const": "passed" },
        "detail": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
