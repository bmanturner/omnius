{
  "asyncapi": "3.1.0",
  "channels": {
    "realtimeEvents": {
      "address": "/events",
      "bindings": {
        "http": {
          "bindingVersion": "0.3.0"
        }
      },
      "description": "Named SSE events. Clients resume with the bounded `cursor` query parameter when the selected provider supplies a genuine cursor; heartbeat comments carry no event.",
      "messages": {
        "BrowserDomainEventV1": {
          "$ref": "#/components/messages/BrowserDomainEventV1"
        },
        "SseReconnectV1": {
          "$ref": "#/components/messages/SseReconnectV1"
        },
        "SubscriptionRevokedV1": {
          "$ref": "#/components/messages/SubscriptionRevokedV1"
        }
      },
      "servers": [
        {
          "$ref": "#/servers/sameOriginHttp"
        }
      ],
      "title": "Resumable server-sent events",
      "x-resume": {
        "cursorField": "$message.payload#/payload/cursor",
        "duplicates": "at-least-once delivery; consumers must tolerate duplicates",
        "lastEventIdHeader": "rejected to prevent ambiguous cursors",
        "requestQuery": "cursor"
      }
    },
    "realtimeWebSocket": {
      "address": "/realtime/ws",
      "bindings": {
        "ws": {
          "bindingVersion": "0.1.0",
          "headers": {
            "properties": {
              "Sec-WebSocket-Protocol": {
                "const": "omnius.realtime.v1"
              }
            },
            "required": [
              "Sec-WebSocket-Protocol"
            ],
            "type": "object"
          },
          "method": "GET"
        }
      },
      "description": "Versioned bidirectional JSON envelopes using the required negotiated subprotocol.",
      "messages": {
        "BrowserDomainEventV1": {
          "$ref": "#/components/messages/BrowserDomainEventV1"
        },
        "CommandRejectedV1": {
          "$ref": "#/components/messages/CommandRejectedV1"
        },
        "PingV1": {
          "$ref": "#/components/messages/PingV1"
        },
        "PongV1": {
          "$ref": "#/components/messages/PongV1"
        },
        "SubscriptionCreateV1": {
          "$ref": "#/components/messages/SubscriptionCreateV1"
        },
        "SubscriptionCreatedV1": {
          "$ref": "#/components/messages/SubscriptionCreatedV1"
        },
        "SubscriptionDeleteV1": {
          "$ref": "#/components/messages/SubscriptionDeleteV1"
        },
        "SubscriptionDeletedV1": {
          "$ref": "#/components/messages/SubscriptionDeletedV1"
        },
        "SubscriptionRevokedV1": {
          "$ref": "#/components/messages/SubscriptionRevokedV1"
        }
      },
      "servers": [
        {
          "$ref": "#/servers/sameOriginWebSocket"
        }
      ],
      "title": "Authenticated realtime WebSocket"
    }
  },
  "components": {
    "messages": {
      "BrowserDomainEventV1": {
        "contentType": "application/json",
        "correlationId": {
          "description": "UUIDv7 command/event correlation identifier when the message contract permits one.",
          "location": "$message.payload#/correlation_id"
        },
        "name": "BrowserDomainEventV1",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "oneOf": [
                {
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "cursor": {
                  "oneOf": [
                    {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[!-~]+$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "data": {
                  "maxProperties": 1024,
                  "type": "object"
                },
                "subscription_id": {
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "topic": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:/-]+$",
                  "type": "string"
                }
              },
              "required": [
                "subscription_id",
                "topic",
                "cursor",
                "data"
              ],
              "type": "object"
            },
            "type": {
              "not": {
                "enum": [
                  "subscription.create",
                  "subscription.delete",
                  "ping",
                  "subscription.created",
                  "subscription.deleted",
                  "command.rejected",
                  "pong",
                  "subscription.revoked",
                  "reconnect"
                ]
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "v": {
              "const": 1
            }
          },
          "required": [
            "v",
            "id",
            "type",
            "correlation_id",
            "payload"
          ],
          "type": "object"
        },
        "summary": "Version 1 module-owned domain-event envelope; the wire `type` is the stable module-owned event name and `v` is the envelope version.",
        "title": "BrowserDomainEventV1",
        "x-direction": "server-to-client",
        "x-message-version": 1,
        "x-wire-name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "reservedNamesExcluded": true
        }
      },
