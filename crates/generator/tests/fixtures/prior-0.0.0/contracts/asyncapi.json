  "defaultContentType": "application/json",
  "info": {
    "description": "Typed browser-facing WebSocket, SSE, and module-owned domain-event envelopes. HTTP remains authoritative for state reconstruction.",
    "title": "Omnius browser realtime contract",
    "version": "0.1.0"
  },
  "operations": {
    "receiveWebSocketCommands": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/realtimeWebSocket"
      },
      "messages": [
        {
          "$ref": "#/channels/realtimeWebSocket/messages/SubscriptionCreateV1"
        },
        {
          "$ref": "#/channels/realtimeWebSocket/messages/SubscriptionDeleteV1"
        },
        {
          "$ref": "#/channels/realtimeWebSocket/messages/PingV1"
        }
      ],
      "security": [
        {
          "$ref": "#/components/securitySchemes/sessionCookie"
        }
      ],
      "summary": "Receive authorized browser commands"
    },
    "sendServerSentEvents": {
      "action": "send",
      "bindings": {
        "http": {
          "bindingVersion": "0.3.0",
          "method": "GET",
          "query": {
            "additionalProperties": false,
            "properties": {
              "cursor": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[!-~]+$",
                "type": "string"
              },
              "subscription_id": {
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "topic": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:/-]+$",
                "type": "string"
              }
            },
            "required": [
              "subscription_id",
              "topic"
            ],
            "type": "object"
          }
        }
      },
      "channel": {
        "$ref": "#/channels/realtimeEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/realtimeEvents/messages/SubscriptionRevokedV1"
        },
        {
          "$ref": "#/channels/realtimeEvents/messages/BrowserDomainEventV1"
        },
        {
          "$ref": "#/channels/realtimeEvents/messages/SseReconnectV1"
        }
      ],
      "security": [
        {
          "$ref": "#/components/securitySchemes/sessionCookie"
        }
      ],
      "summary": "Send named resumable SSE events"
    },
    "sendWebSocketMessages": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/realtimeWebSocket"
      },
      "messages": [
        {
          "$ref": "#/channels/realtimeWebSocket/messages/SubscriptionCreatedV1"
        },
        {
          "$ref": "#/channels/realtimeWebSocket/messages/SubscriptionDeletedV1"
        },
        {
          "$ref": "#/channels/realtimeWebSocket/messages/CommandRejectedV1"
        },
        {
          "$ref": "#/channels/realtimeWebSocket/messages/PongV1"
        },
        {
          "$ref": "#/channels/realtimeWebSocket/messages/SubscriptionRevokedV1"
        },
        {
          "$ref": "#/channels/realtimeWebSocket/messages/BrowserDomainEventV1"
        }
      ],
      "security": [
        {
          "$ref": "#/components/securitySchemes/sessionCookie"
        }
      ],
      "summary": "Send command results, controls, and domain events"
    }
  },
  "servers": {
    "sameOriginHttp": {
      "bindings": {
        "http": {
          "bindingVersion": "0.3.0"
        }
      },
      "description": "Same-origin HTTP endpoint carrying an SSE stream.",
      "host": "{host}",
      "pathname": "/",
      "protocol": "https",
      "security": [
        {
          "$ref": "#/components/securitySchemes/sessionCookie"
        }
      ],
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    },
    "sameOriginWebSocket": {
      "bindings": {
        "ws": {
          "bindingVersion": "0.1.0"
        }
      },
      "description": "Same-origin WebSocket endpoint; use ws in non-TLS development only.",
      "host": "{host}",
      "pathname": "/realtime/ws",
      "protocol": "wss",
      "security": [
        {
          "$ref": "#/components/securitySchemes/sessionCookie"
        }
      ],
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  }
